{
  "manifest_version": 3,
  "name": "BD Railway Ticket Quick Booker",
  "version": "1.0.0",
  "description": "Pre-configure route, journey date, and seat class to instantly search and book tickets on Bangladesh Railway e-ticket portal.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://eticket.railway.gov.bd/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "BD Railway Quick Search"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eticket.railway.gov.bd/booking/train/search*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

